# Local script outputs (default output-dir is current dir, not docs/).
# Run with --output-dir docs only in CI — see .github/workflows/update-lifecycle.yml.
lifecycle-*.html
lifecycle-*.svg
lifecycle-*.png
lifecycle.html
lifecycle.svg
lifecycle.png
index.html
_lifecycle_png.html
__pycache__/

# Local credential files: never commit them.
# No slash in the pattern: matches at any depth.
client-id.txt
client-secret.txt
